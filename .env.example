# =============================================================================
# ML Framework — Live Integration Testing Environment Configuration Template
# Copy this file to .env and configure with your team's authorized service details:
#   cp .env.example .env
#
# IMPORTANT:
# - NEVER commit your .env file or real credentials to version control.
# - Do not place real credentials in this .env.example template.
# =============================================================================

# -----------------------------------------------------------------------------
# Opt-in Flags (Set to 1 to activate live infrastructure integration tests)
# -----------------------------------------------------------------------------
TEST_LIVE_MINIO=0
TEST_LIVE_KAFKA=0

# -----------------------------------------------------------------------------
# MinIO / S3 Object Storage Configuration
# -----------------------------------------------------------------------------
# HTTP(S) endpoint URL of the team's running MinIO or S3 service
MINIO_ENDPOINT=http://<minio-host>:<port>

# Authorized access key ID and secret access key
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>

# Dedicated test bucket (do NOT use production or shared application buckets)
MINIO_TEST_BUCKET=ml-framework-integration-test

# Storage region (defaults to us-east-1 for MinIO/SeaweedFS)
MINIO_REGION=us-east-1

# Set to true if the endpoint uses TLS/HTTPS
MINIO_SECURE=false

# Set to true to bypass TLS certificate verification (e.g., self-signed certs or internal test endpoints)
MLFLOW_S3_IGNORE_TLS=false

# -----------------------------------------------------------------------------
# Kafka Message Streaming Configuration
# -----------------------------------------------------------------------------
# Kafka broker bootstrap servers (host:port)
KAFKA_BOOTSTRAP_SERVER=<kafka-host>:<port>

# Dedicated integration test topic (never use shared or production topics)
KAFKA_TEST_TOPIC=ml-framework-integration-test-topic

# Base consumer group identifier for live tests
KAFKA_GROUP_ID=ml-framework-live-consumer

# -----------------------------------------------------------------------------
# Kafka Authentication & Security (Optional — leave empty for plaintext clusters)
# -----------------------------------------------------------------------------
# Security protocol: PLAINTEXT, SASL_PLAINTEXT, SASL_SSL, SSL
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# SASL mechanism: PLAIN, SCRAM-SHA-256, SCRAM-SHA-512, GSSAPI
KAFKA_SASL_MECHANISM=PLAIN

# SASL credentials (if cluster authentication is enabled)
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# SSL certificate paths (if custom SSL certificates are required)
KAFKA_SSL_CA_LOCATION=
KAFKA_SSL_CERTIFICATE_LOCATION=
KAFKA_SSL_KEY_LOCATION=
